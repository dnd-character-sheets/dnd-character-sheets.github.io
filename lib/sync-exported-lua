#!/usr/bin/env bash
#
# keep lib/lua/ in sync with the author's live ~/src/lua.
#
# bin/charsheet (and gmsheet, gmspells) need several small Lua modules
# that live only in the author's personal ~/src/lua tree.  lib/lua/
# carries a copy of each one so a clone can run without
# access to that tree.
#
# Run this script to check and see if copies are current.
# Run with -u to update.

set -euo pipefail

here=$(cd "$(dirname "$0")/.." && pwd)
srcdir=$HOME/src/lua
arg0="$(basename "$0")"

names=(flags inspect module52 tabutil tablex
       stringutil stringx linebreak ioutil iox)
paths=("${names[@]/%/.lua}" validate/dsl.lua)

update=false
while [[ $# -gt 0 ]]; do
  case $1 in
     -u) update=true; shift ;;
     *) echo "$arg0: unknown option or argument '$1'" 2>&1; exit 2 ;;
  esac
done

[[ -d $srcdir ]] || exit 0

stale=()
for rel in "${paths[@]}"; do
  src=$srcdir/$rel
  dst=$here/lib/lua/$rel
  if [[ ! -e $src ]]; then
    echo "$arg0: $src does not exist" 1>&2
    stale+=("$rel")
  elif $update; then
    mkdir -p "$(dirname "$dst")"
    cp -uv "$src" "$dst"
  elif ! cmp -s "$src" "$dst"; then
    stale+=("$rel")
  fi
done

if $update; then
  exit 0
elif [[ ${#stale[@]} -gt 0 ]]; then
  echo "$arg0: lib/lua/ is stale with respect to $srcdir" 1>&2
  printf '  %s\n' "${stale[@]}" 1>&2
  echo "$arg0:" 'run `lib/sync-exported-lua -u` to refresh' 1>&2
  exit 1
fi
