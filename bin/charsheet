__doc.randomize = [[function(xs, [random]) returns ys
Result ys is a fresh list containing elements of xs in random order.
]]
function M.randomize(l, random)
  random = random or math.random
  local u = { }
  local n = #l
  for i = 1, n do
    u[i] = l[i]
  end
  for i = 1, n do
    local j = random(n)
    u[i], u[j] = u[j], u[i]
  end
  return u
end

