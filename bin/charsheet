    bad_control_sequences['\\'..cs] = true
  end
end

local function sanitize_control_sequences(s)
  return (s:gsub([[%\%a+]],
            function(cs) if bad_control_sequences[cs] then
                return stringf([[\texttt{\textbackslash %s}]], cs:sub(2))
            end
  end))
end



--------- document (charsheet) utilities

local function named_things(sheet) -- anything in MAGIC or FEATURES with a .name field
  return coroutine.wrap(function()
    for _, section in ipairs {'MAGIC', 'FEATURES'} do
      local things = table_or_nothing(sheet[section])
      for _, thing in ipairs(things) do
        if thing.name then
          coroutine.yield(thing)
        end
      end
    end
  end)
end


------------------------------------------------------------------------
--
-- General-purpose validation predicates

local function wrap(p) -- on failure, produces the offending field (XXX name)
  return function(v)
    if p(v) then return true else return false, v end
  end
end

local function any(p, list, first, last) -- existential quantifier
  local ok, msg
  first = first or 1
  last = last or #list
  for i = first, last do
    ok, msg = p(list[i])
    if ok then
      return ok
    end
  end
  return false, msg
end

-- predicate `can_be(tau1, tau2, ...)(v)` knows about type conversions

local can_be_tab = {
  string = wrap(function(v)
             return type(v) == 'string' or type(v) == 'number' or type(v) == 'boolean'
             end),
  number = wrap(function(v) return tonumber(v) end),
  boolean = wrap(function(v) return type(v) == 'boolean' or tostring(v):find '^[01]$' end),
}
setmetatable(can_be_tab, { __index = function(_, t)
                                       return wrap(function(v) return type(v) == t end)
                           end})

local function can_be(...)
  local types = { ... }
  return function(v) return any(function(t) return can_be_tab[t](v) end, types) end
end

assert(can_be 'string'('hello'))
assert(can_be 'string'(7))

local empty = wrap(function(v)
  return v == nil
      or type(v) == 'table' and next(v) == nil
      or type(v) == 'string' and not v:find '%S'
      or false
end)

local is_singleton_table = wrap(function(t)
  if type(t) == 'table' then
    local k = next(t)
    return k ~= nil and next(t, k) == nil
  end
end)

local islist = wrap(function(t)
  return type(t) == 'table' and (empty(t) or t[1] ~= nil)
end)


------------------------ Validators for character sheets -------------------

-- XXX some strings are now allowed to be empty
local magic_property = {
  bonus = 'the spell may be cast as a bonus action',
  reaction = 'the spell may be cast as a reaction',
  attack = 'casting the spell requires an attack roll',
  save = 'the stat the enemy has to use to make a saving throw',
  enemy = 'the spell targets an enemy [implied by `attack` or `save`]',
  ritual = 'the spell may be cast as a ritual',
  duration = 'how long the spell lasts, if more than one action',
  abbrev = "short description for GM's spell list",
  concentration = 'the spell requires concentration',
  name = 'Name of the spell',
  description = 'How the spell works',
  long = 'Long description',
  material = 'Material components',
  components = 'What of MSV is required to cast the spell',
  domain = 'the spell is a domain spell',
  freebie = 'does not count against number of spells caster can know (e.g., domain, circle)',
  range = 'how far the spell can be cast',
}

function validators.components(context, v)
  if not v:find '^[MSV]+$' then
    verrorf(context, 'expected components to be a subset of MSV, but found %q', v)
  end
end

local magicpropnames -- spec for validation keys
do
  local names = { }
  for k in pairs(magic_property) do
    if k == 'components' then
      table.insert(names, '?components:components$s')
    elseif k == 'freebie' then
      table.insert(names, '?freebie:s|b')
    else
      table.insert(names, k == 'name' and k or '?' .. k)
    end
  end
  magicpropnames = table.concat(names, ', ')
end

local equipment = { }

-- EQUIPMENT
equipment.canonical_category = {
  ["heavy weapon"] = "HEAVY WEAPONS",
  ["normal weapon"] = "NORMAL WEAPONS",
  ["light weapon"] = "LIGHT WEAPONS",
  ["shield"] = "SHIELDS",
  ["heavy armor"] = "HEAVY ARMOR",
  ["heavy armour"] = "HEAVY ARMOR",
  ["normal armor"] = "MEDIUM ARMOR",
  ["normal armour"] = "MEDIUM ARMOR",
  ["medium armor"] = "MEDIUM ARMOR",
  ["medium armour"] = "MEDIUM ARMOR",
  ["light armor"] = "LIGHT ARMOR",
  ["light armour"] = "LIGHT ARMOR",
  ["heavy item"] = "HEAVY ITEMS",
  ["slotted item"] = "SLOTTED ITEMS",
  ["free item"] = "SMALL ITEMS",
  ["small item"] = "SMALL ITEMS",
  ["stored item"] = "STORED ITEMS",
  ["stored"] = "STORED ITEMS",
}

function equipment.good_category(c)
  c = tostring(c):lower():gsub('s$', '')
  if equipment.canonical_category[c] then
    return c
  end
end

function equipment.category(s)
  local function strip_s(s)
    if s:sub(-1) == 's' then
      return s:sub(1, -2)
    else
      return s
    end
  end

  return equipment.canonical_category[strip_s(tostring(s):lower())]
end

do -- set equipment.tablespec
  local catspecs = { }
  local function catspec(category)
    return stringf('?^%s:(s|list(s))', category)
  end
  for category in pairs(equipment.canonical_category) do
    table.insert(catspecs, catspec(category))
    table.insert(catspecs, catspec(category .. 's'))
  end
  equipment.tablespec = stringf('{%s}', table.concat(catspecs, ', '))
end

vnames.equipment = 'equipment list'

local sheet_validation = ([[

  -- validation spec for a full character sheet

  sheet${
    CLASS:nonempty$s,
    ?LEVEL:n[1..30],

    ?DOCUMENT FONT:docfont$s,

    ?CHARACTER NAME, ?PLAYER NAME, ?RACE, ?BACKGROUND, ?SENSES,

    ABILITIES

    ?MAX HP:n[1..],
    ?ARMOR CLASS:n[1..],
    ?PASSIVE PERCEPTION:n[1..],

    ?SPELL DC:n,
    ?DOMAIN SPELLS:n[1..],
    ?SPELLS KNOWN:spellcount$s,
    ?SPELLS PREPARED:spellcount$s,
    ?CANTRIPS KNOWN:spellcount$s,
    ?SORCERY POINTS:n,

    ?AGE, ?DESCRIPTION, ?MOTIVATION, ?SPECIALTY, ?ALIGNMENT,
    ?HIT DICE, ?INITIATIVE, ?SPEED, ?EXPERIENCE POINTS,
    ?CURRENT HIT POINTS, ?PROFICIENCY BONUS:n,

    ?CP:empty|n[0..],
    ?SP:empty|n[0..],
    ?EP:empty|n[0..],
    ?GP:empty|n[0..],
    ?PP:empty|n[0..],


    ?GM NOTES,

    ?PREGENERATED:b,
    ?MAGIC SEPARATE:b,

    ?%ATTACKS:ATTACKS@list(
       attack${ NAME, ATTACK, DAMAGE, TYPE, ?RANGE, ?AMMO TYPE, ?AMMO COUNT:n, ?NOTES}),
    ?%FEATURES:FEATURES@list(described$feature@
           {name,?description
           ,?abbrev,?bonus:b,?enemy:b,?save,?attack:b,?long,?duration,?reaction:b
           ,?markers:b -- add "magic markers" to name (default false)?
           ,?GM note:(b|s)
           }),
    ?%MAGIC:MAGIC@list(described$spell@{MAGICPROPNAMES}
               |{acquired at level:n[1..20]}
               |level$level-spec@{level:n[0..9],?slots:n[1..]}
               |null
               ),
    ?%EQUIPMENT:equipment@(etable@EQUIPMENT_TABLE|list(eqline$string)),

    ?FEATURES SPACE,
    ?EQUIPMENT COLS:n[1..3],
    ?EQUIPMENT LEFT:b,

    ?STONES:b, -- use Alexandrian stones

  --  ?%PROFICIENCIES:list(s|empty|{proficiencies_skip:bool}|list(s|empty)),
    ?%PROFICIENCIES:list(s|empty|{proficiencies_skip:bool}|{*:list(s)}),
    ?SECONDARY PROFICIENCIES:list(s|empty|{proficiencies_skip:bool}|{*:list(s)}),

    ?LAYOUT,
    ?SHEET ORIGIN,
    ?COLOR:b,
    ?TRAITS:b,
    ?SPELL ATTACK MODIFIER:n,
    ?SPELLCASTING ABILITY,
    ?SPELLCASTING ABILITY MODIFIER:n,

    ?SUGGESTED NAMES:list(s),
    ?SUGGESTED MOTIVATIONS:list(s),

    ?OTHER:any,

  }
]]):gsub('%-%-.-\n', '')
   :gsub('MAGICPROPNAMES', magicpropnames)
   :gsub('EQUIPMENT_TABLE', equipment.tablespec)
   :gsub('ABILITIES', ('STR DEX CON INT WIS CHA')
        :gsub('%S+', '?%1:n[1..20], ?%1 SAVING:b, '))

------- validators used in the sheet spec ----

vnames.etable = 'categorized list of equipment'

function validators.docfont(_, v)
  if not v:find '^1[012]pt$' then
    verrorf('The DOCUMENT FONT must be 10pt, 11pt, or 12pt; found %q', v)
    return '10pt'
  end
end

function validators.attack(context, v)
  if not empty(v['AMMO COUNT']) and empty(v['AMMO TYPE']) then
    verrorf(context, 'AMMO COUNT is specified without an AMMO TYPE')
    return update(v, 'AMMO COUNT', nil)
  end
end

local function description(thing)
  return thing.description or thing.long or thing.abbrev
end

function validators.described(context, v)
  if not description(v) then
    verrorf(context, '%q has no description', v.name)
    return update(v, 'description', '???')
  end
end

function validators.level(context, v)
  if v.level == 0 and v.slots then
    verrorf(context, 'spec for cantrips (level 0) included slots, but cantrips have no slots')
    return { level = 0 }
  elseif v.level > 0 and not v.slots then
    verrorf(context, 'spec for level %d is missing its slot count', v.level)
    return { level = v.level, slots = 1 }
  end
end

function validators.spellcount(context,v)
  if v:find '^%s*%d+%s*$' then
    return tonumber(v)
  else
    local n1, n2 = v:match '^%s*(%u+)%s+%+%s+(%u+)%s*$'
    if not n1 then
      verrorf(context, 'Expected formula for spells known or prepared; found %q', v)
      return 3
    else
      return {n1, n2}
    end
  end
end

function validators.eqline(context, v)
  local cat = v:match '^(.-):'
  if cat and not equipment.good_category(cat) then
    verrorf(context, 'equipment line %q uses an unknown category %q', v, cat)
    return (v:gsub('%:', '---'))
  end
end

function validators.nonempty(context, v)
  if empty(v) then
    verrorf(context, 'expected data but found %s', friendly(v))
    return 'missing'
  end
end

local ability_modifier

local function eval_prepcount(sheet, s)
  if can_be 'number' (s) then
    return tonumber(s)
  elseif type(s) == 'table' then
    local total = 0
    for _, what in ipairs(s) do
      local n = what == 'LEVEL' and sheet.LEVEL or ability_modifier(sheet[what] or 10)
      total = total + assert(tonumber(n))
    end
    return total
  else
    assert(false)
  end
end

local function spellcounts(magic)
  local level = 0
  local cantrips, spells = 0, 0
  for _, thing in ipairs(magic) do
    if thing.level then
      level = thing.level
    elseif thing.name and not (thing.freebie or thing.domain) then
      if level == 0 then
        cantrips = cantrips + 1
      else
        spells = spells + 1
      end
    end
  end
  return cantrips, spells
end

-- Validation function
function validators.sheet(context, sheet)
  if not empty(sheet.WIS) and empty(sheet['PASSIVE PERCEPTION']) then
    verrorf(context, 'WIS is present but PASSIVE PERCEPTION is missing')
    -- no need to fix here; extend() handles it
  end
  for _, key in ipairs {'SPELLS PREPARED', 'SPELLS KNOWN', 'CANTRIPS KNOWN' } do
--    eprintf('check %s == %s\n', key, friendly(sheet[key]))
    if not empty(sheet[key]) then
      local n = eval_prepcount(sheet, sheet[key])
      local cantrips, spells = spellcounts(sheet.MAGIC or nothing)
      local what     = key:find 'CANTRIPS' and 'cantrips' or 'spells'
      local how_many = key:find 'CANTRIPS' and cantrips or spells
      if n > how_many then
        verrorf('character can know %d %s, but they only know %d', n, what, how_many)
      elseif n < how_many then
        verrorf('character can only know %d %s, but they know %d', n, what, how_many)
      end
    end
  end
end

local function default_validator_meta(validator)
  return { __index = function() return validator end }
end
  -- used to define partial validators


local function check_validator_use()
  local validators_used = { }
  local methods = setmetatable({}, default_validator_meta(function() return false end))
  function methods:validate(name, v)
    validators_used[name] = true
    return v
  end
  validate.parse(methods, sheet_validation)
  for k in pairs(validators_used) do
    if not validators[k] then
      errorf('Function validators.%s is not defined\n', k)
    end
  end
  for k in pairs(validators) do
    if not validators_used[k] then
      errorf('Function validators.%s is not used\n', k)
    end
  end
end

check_validator_use()

