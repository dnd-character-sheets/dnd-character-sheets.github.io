local _ENV = _ENV
package.preload[ "set" ] = function( ... ) local arg = _G.arg;
local type, pairs, unpack, tostring, next, assert, setmetatable, getmetatable
    = type, pairs, unpack, tostring, next, assert, setmetatable, getmetatable

local table, math, string
    = table, math, string

local require = require
local pcall, error
    = pcall, error

local index = { }
local setmeta = { __index = index }
local function s(t) return setmetatable(t, setmeta) end

local M, __doc, thismodule, _ENV = require 'module52'.new()

__doc.__overview = [[
Sets of non-nil values; each set is represented
using a Lua table with the members as keys;
corresponding values are typically the Boolean true.
Supports infix operations +, -, *, and comparisons
]]

__doc.is = [[function(value) returns bool
Return true iff the value is a set (with the set metatable)
]]

function M.is(value)
  return type(value) == 'table' and getmetatable(value) == setmeta
end

__doc.elements = [[function(set) returns generator returns element]]

M.elements = pairs

__doc.sorted_elements = [[function(set[, lt]) returns list]]

M.sorted_elements = table.sorted_keys

__doc.map = [[function(function, set) returns set
Return new set resulting from applying function to every element of set.
]]
function M.map(...) return s(table.setmap(...)) end
  
__doc.argmin = [[function(function, set) returns element, value
argmin(f, xs) returns the element of xs that minimizes the output
of f.  The minimum value is also returned.  Returns nil if set is empty.
]]

function M.argmin(f, t)
  local bestarg, bestx = nil, math.huge
  for k in pairs(t) do
    local x = f(k)
    if bestarg == nil or x < bestx then
      bestarg, bestx = k, x
    end
  end
  return bestarg, bestx
end

function M.argmax(f, t)
  local x, v = M.argmin(function(x) return -f(x) end, t)
  return x, -v
end

__doc.fold = [[function(function, set, ...) returns value]]

local function pack(...) return { ... } end

function M.fold(f, t, ...)
  local z = pack(...)
  for k in pairs(t) do
    z = pack(f(k, unpack(z)))
  end
  return unpack(z)
end

__doc.forall = [[function(predicate, set) returns bool]]
__doc.exists = [[function(predicate, set) returns bool]]

function M.forall(f, l)
  for v in pairs(l) do
    if not f(v) then
      return false
    end
  end
  return true
end

function M.exists(f, l)
  for v in pairs(l) do
    if f(v) then
      return true
    end
  end
  return false
end

__doc.find = [[function(predicate, set) returns element or nothing]]
function M.find(f, l)
  for v in pairs(l) do
    if f(v) then
      return v
    end
  end
end

__doc.of_list = [[function(list) returns set]]
__doc.to_list = [[function(set) returns list]]
__doc.of_set =  [[function(table) returns set with metatable]]

function M.of_list(xs)
  return s(table.set(xs))
end

M.set = M.of_list
M.of_set = s

function M.to_list(xs)
  local l = { }
  for k in pairs(xs) do
    table.insert(l, k)
  end
  return l
end

__doc.of_keys = [[function(table) returns set of that table's keys]]
function M.of_keys(t)
  local u = { }
  for k in pairs(t) do u[k] = true end
  return s(u)
end

__doc.of_iterator = [[function(iterator) returns set
Return the set of items produced by the iterator.
]]

function M.of_iterator(...)
  local u = { }
  for v in ... do u[v] = true end
  return s(u)
end

__doc.of_matches = [[function(string, [pattern]) returns set
Set of matches of pattern in string.  Pattern defaults to '%S+'.
]]

function M.of_matches(s, p)
  return M.of_iterator(string.gmatch(s, p or '%S+'))
end

M.subset = table.subset
setmeta.__le = M.subset
M.minus = table.setminus
setmeta.__sub = M.minus

function M._tostring(s, sort)
  local l = table.map(tostring, M.to_list(s))
  if sort then table.sort(l) end
  if #l == 0 then
    return "{ }"
  else
    return table.concat { "{ ", table.concat(l, ", "), " }" }
  end
end
setmeta.__tostring = M._tostring

__doc.key = [[function(set) returns string
Returns a string key that is unique to the given set,
provided each element converts to a unique 'tostring'.
]]

function M.key(s) return M._tostring(s, true) end


__doc.size = [[function(set) returns number]]
M.size = table.numpairs
setmeta.__len = M.size

__doc.setunion = [[function(set of sets) returns set]]
function M.setunion(sets)
  local u = s { }
  for set in pairs(sets) do
    u = u + set
  end
  return u
end


function M.union(...)
  local ok, answer = pcall(table.union, ...)
  if not ok then
    local inspect = require 'inspect'
    inspect.show(...)
    error(answer)
  else
    return s(answer)
  end
  -- return s(table.union(...))
end
setmeta.__add = M.union

function M.inter(s1, s2)
  local t = { }
  for k in pairs(s1) do
    if s2[k] then
      t[k] = true
    end
  end
  return s(t)
end
setmeta.__mul = M.inter

function M.xor(s1, s2)
  local t = { }
  for x in pairs(s1) do
    if not s2[x] then t[x] = true end
  end
  for x in pairs(s2) do
    if not s1[x] then t[x] = true end
  end
  return s(t)
end
setmeta.__pow = M.xor

function M.eq(s1, s2)
  return s1 <= s2 and s2 <= s1
end

function M.lt(s1, s2)
  return s1 <= s2 and not (s2 <= s1)
end
setmeta.__eq = M.eq
setmeta.__lt = M.lt

function M.copy(t)
  local u = { }
  for k in pairs(t) do u[k] = true end
  return s(u)
end

__doc.filter = [[function(predicate, set) returns set
Return a new set that is like the argument set except it
contains only elements satisfying the predicate function.
]]

function M.filter(f, l)
  local u = { }
  for v in pairs(l) do
    if f(v) then
      u[v] = true
    end
  end
  return s(u)
end

function M.insert(set, x)
  set[x] = true
  return set
end
index.insert = M.insert

__doc.is_empty = [[function(set) returns bool]]
function M.is_empty(s)
  return next(s) == nil
end
index.is_empty = M.is_empty

function M.singleton(v)
  return s { [v] = true }
end

function M.is_singleton(t)
  local k = next(t)
  return k ~= nil and next(t, k) == nil
end

__doc.partition = [[function(f, set) returns set of sets
Returns a mimimal partition of 'set' (set of nonoverlapping subsets)
such that f maps elements of a subset to equal values.
]]

function M.partition(f, set)
  assert(f and set)
  local subsets = { } -- map representative to partition
  local function add(v)
    local mapped = f(v)
    for rep, equiv in pairs(subsets) do
      if mapped == rep then
        equiv[v] = true
        return
      end
    end
    subsets[mapped] = s { [v] = true }
  end
  for v in pairs(set) do add(v) end
  local partition = s { }
  for _, equiv in pairs(subsets) do
    partition[equiv] = true
  end
  return partition
end

local small = M.of_list {1, 2, 3, 4, 5}
local large = M.of_list {1, 5, 10, 100, 1000}
local xsmall_large = small ^ large


__doc.extrema = [[function(set, lt) returns value, value
return the smallest, largest values in the given set (by lt),
or nil, nil if the set is empty.  lt defaults to <.
]]

function M.extrema(set, lt)
  lt = lt or function(v1, v2) return v1 < v2 end
  local smallest, largest = nil, nil
  for v in pairs(set) do
    if smallest == nil or lt(v, smallest) then
      smallest = v
    end
    if largest == nil or lt(largest, v) then
      largest = v
    end
  end
  return smallest, largest
end


assert(M.eq(xsmall_large, M.of_list {2, 3, 4, 10, 100, 1000}))
assert(M.is_empty(small ^ small))
assert(M.eq(small ^ M.of_list {}, small))
assert(M.eq(xsmall_large, M.xor(small, large)))
assert(M.eq((xsmall_large ^ large), small))
assert(((small ^ large) + M.singleton(42))[42])

assert(M.is_singleton(M.singleton(99)))
assert(M.is_singleton(M.of_list { 88 }))
assert(not M.is_singleton(M.of_list { 88, 89 }))
assert(not M.is_singleton(M.of_list { }))


M._test = {
  small = small,
  large = large,
  inter = small * large,
  union = small + large,
  xor   = xsmall_large,
  sub   = small <= large,
  self_le = small <= small,
  self_lt = small < small,
  self_eq = small == small,
  isub    = small * large <= small,
  usub    = small <= small + large,
  parity = M.partition(function (n) return n % 2 == 0 end, small + large),
}

return thismodule()
end
end

