#!/usr/bin/env bash
#
# configure -- check that this machine has what charsheet needs
#
# Run it after cloning, and again whenever you reinstall Lua or
# luarocks packages on this machine.

set -euo pipefail

arg0="$(basename "$0")"
here=$(cd "$(dirname "$0")" && pwd)
charsheet=$here/bin/charsheet

note() { echo "$arg0: $*" 1>&2; }
fail() { echo "$arg0: $*" 1>&2; exit 1; }

# ---- Lua interpreter, luarocks, lyaml ------------------------
# charsheet runs under either Lua 5.1 or 5.2.  A version only counts as
# working if lyaml loads from its luarocks tree.

command -v luarocks >/dev/null 2>&1 \
  || fail "luarocks not found on \$PATH; install it (e.g. 'apt install luarocks')"

working=()
for version in 5.1 5.2; do
  candidate=lua$version
  command -v "$candidate" >/dev/null 2>&1 || { note "$candidate not found"; continue; }

  path=$(luarocks --lua-version=$version path --lr-path 2>/dev/null || true)
  cpath=$(luarocks --lua-version=$version path --lr-cpath 2>/dev/null || true)
  if [[ -z $path ]]; then
    # older luarocks: fall back to parsing `luarocks path`'s export lines
    path=$(luarocks --lua-version=$version path 2>/dev/null \
             | sed -n "s/^export LUA_PATH='\(.*\)'\$/\1/p")
    cpath=$(luarocks --lua-version=$version path 2>/dev/null \
             | sed -n "s/^export LUA_CPATH='\(.*\)'\$/\1/p")
  fi
  if [[ -z $path ]]; then
    note "$candidate found, but luarocks has no Lua $version rocks path"
    continue
  fi

  if ! LUA_PATH="$path;;" LUA_CPATH="$cpath;;" "$candidate" -e "require 'lyaml'" >/dev/null 2>&1; then
    note "$candidate found, but lyaml doesn't load via its luarocks path -- run 'luarocks --lua-version=$version install lyaml'"
    continue
  fi

  note "$candidate works: lyaml loads"
  working+=("$candidate")
done

[[ ${#working[@]} -gt 0 ]] || fail "no working Lua 5.1 or 5.2 install found -- see the notes above"

shebang_lua=$(sed -n '1s|^#!/usr/bin/env \(lua5\.[12]\)$|\1|p' "$charsheet")
if [[ -n $shebang_lua ]] && [[ ! " ${working[*]} " == *" $shebang_lua "* ]]; then
  note "warning: bin/charsheet's shebang wants $shebang_lua, which isn't one of the working interpreters above"
  note "warning: invoke it explicitly instead, e.g. '${working[0]} bin/charsheet ...'"
fi

# ---- TeX ---------------------------------------------------------------
command -v pdflatex >/dev/null 2>&1 || fail "pdflatex not found; install a TeXLive distribution"
command -v xelatex  >/dev/null 2>&1 || fail "xelatex not found; install a TeXLive distribution"
note "found pdflatex and xelatex"

packages=(amsmath array booktabs calc colortbl enumitem environ fontspec
          geometry ifmtarg ifthen iftex multicol pgfkeys soul suffix
          tabularx times tikz xcolor xstring)
if command -v kpsewhich >/dev/null 2>&1; then
  missing=()
  for p in "${packages[@]}"; do
    kpsewhich "$p.sty" >/dev/null 2>&1 || missing+=("$p")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    note "warning: kpsewhich can't find these TeX packages: ${missing[*]}"
    note "warning: a fuller TeXLive install may be needed"
  else
    note "all required TeX packages found"
  fi
else
  note "kpsewhich not found; skipping the TeX package check"
fi

# ---- end-to-end sanity check --------------------------------------------
# Prefer the shebang's own interpreter if it's one of the working ones,
# so this exercises the same invocation INSTALL.md tells people to use;
# otherwise fall back to an explicit interpreter from the working list.
if [[ -n $shebang_lua ]] && [[ " ${working[*]} " == *" $shebang_lua "* ]]; then
  run=("$charsheet")
else
  run=("${working[0]}" "$charsheet")
fi
if ! err=$(CHARSHEETS="$here/templates" "${run[@]}" -o /dev/null -s "$here/yaml/mario.yaml" 2>&1); then
  fail "bin/charsheet still doesn't run (via '${run[*]}'):
$err"
fi
note "bin/charsheet runs, via '${run[*]}'"

cat > bin/dndsheets <<EOF
#!/bin/ksh

dir="$(pwd)"
EOF
cat >> bin/dndsheets <<'EOF'
cmd="$(basename "$0")"

case $# in 
  0) exec "$dir/$cmd" ;;
  *) exec "$dir/$cmd" "$@" ;;
esac
EOF

chmod +x bin/dndsheets

note 'created bin/dndsheets'

note "configured.  Put $here/bin on \$PATH, and set \$CHARSHEETS and"
note "\$TEXINPUTS as INSTALL.md describes, or run from $here."
