#!/usr/bin/env node
// busytex -- run a BusyTeX applet under Node as if it were a native command
//
// usage: busytex APPLET ARG...
//
// APPLET is pdftex, xetex, xdvipdfmx, or kpsewhich; pdflatex and xelatex
// mean pdftex and xetex with that program name.  Environment variable
// BUSYTEX names the directory holding busytex.js and busytex.wasm, and
// TEXMFTREE names the TeX tree (from build-texmf), which the run sees
// at /texmf.  The run also sees copies of the current directory and of
// each host directory named in TEXINPUTS, TEXFORMATS, or an argument;
// files it creates or changes there are copied back.  A TeX run that
// would write a PDF natively runs xdvipdfmx after xetex, as xelatex does.

'use strict';
const fs = require('fs');
const path = require('path');

const [applet, ...args] = process.argv.slice(2);
const busytexDir = process.env.BUSYTEX;
const tree = process.env.TEXMFTREE;
const programs = { pdflatex: 'pdftex', xelatex: 'xetex' };   // program name -> applet

// directories to mirror: [host path, recursive?]
function mirrored() {
  const dirs = new Map([[process.cwd(), false]]);
  for (const v of ['TEXINPUTS', 'TEXFORMATS'])
    for (const entry of (process.env[v] || '').split(':'))
      if (entry.startsWith('/')) dirs.set(entry.replace(/\/+$/, ''), entry.endsWith('//'));
  for (const a of args) {
    const p = path.resolve(a.replace(/^-+[a-z-]+=/, ''));
    if (fs.existsSync(p)) dirs.set(fs.statSync(p).isDirectory() ? p : path.dirname(p), false);
  }
  return [...dirs].filter(([d]) => fs.existsSync(d) && fs.statSync(d).isDirectory());
}

// copy host directory `from` to `to` in FS; returns map of copied file -> bytes
function copyIn(FS, from, to, recursive, copied = new Map()) {
  FS.mkdirTree(to);
  for (const e of fs.readdirSync(from, { withFileTypes: true })) {
    const [src, dst] = [path.join(from, e.name), path.posix.join(to, e.name)];
    if (e.isFile()) { const b = fs.readFileSync(src); FS.writeFile(dst, b); copied.set(dst, b); }
    else if (e.isDirectory() && recursive) copyIn(FS, src, dst, true, copied);
  }
  return copied;
}

// write back files in FS directory `dir` that are new or changed
function copyOut(FS, dir, copied) {
  for (const name of FS.readdir(dir)) {
    const p = path.posix.join(dir, name);
    if (!FS.isFile(FS.stat(p).mode)) continue;
    const b = FS.readFile(p);
    const old = copied.get(p);
    if (!old || Buffer.compare(Buffer.from(b), old) !== 0) fs.writeFileSync(p, b);
  }
}

// with no -ini or -no-pdf, xetex makes an XDV file that xdvipdfmx turns into PDF
function xdvJob() {
  if (programs[applet] !== 'xetex' && applet !== 'xetex') return null;
  if (args.some(a => /^--?(ini|no-pdf)$/.test(a))) return null;
  const opt = name => { const i = args.findIndex(a => a.replace(/^--?/, '').startsWith(name)); return i < 0 ? null
                        : args[i].includes('=') ? args[i].split('=')[1] : args[i + 1]; };
  const input = args[args.length - 1];
  const job = opt('jobname') || path.basename(input).replace(/\.tex$/, '');
  return path.join(path.resolve(opt('output-directory') || '.'), job);
}

const env = {
  TEXMFCNF: '/texmf/web2c', TEXMF: '/texmf', TEXMFDBS: '', TEXMFVAR: '/tmp/texmf-var',
  FONTCONFIG_PATH: '/texmf/fonts/conf',
};
for (const v of ['TEXINPUTS', 'TEXFORMATS', 'SOURCE_DATE_EPOCH', 'FORCE_SOURCE_DATE'])
  if (process.env[v] !== undefined) env[v] = process.env[v];

(async () => {
  const busytex = require(path.join(busytexDir, 'busytex.js'));
  const config = {
    preRun: [() => Object.assign(config.ENV, env)],  // the environment is fixed at startup
    noInitialRun: true,
    thisProgram: '/bin/busytex',
    wasmBinary: fs.readFileSync(path.join(busytexDir, 'busytex.wasm')),
    print: s => process.stdout.write(s + '\n'),
    printErr: s => process.stderr.write(s + '\n'),
  };
  const M = await busytex(config);
  const FS = M.FS;
  FS.mkdirTree('/bin');
  FS.writeFile('/bin/busytex', '');  // kpathsea looks for the program's directory
  copyIn(FS, tree, '/texmf', true);
  const dirs = mirrored();
  const copied = new Map();
  for (const [d, recursive] of dirs) copyIn(FS, d, d, recursive, copied);
  FS.chdir(process.cwd());

  const xdv = xdvJob();
  const progname = programs[applet] ? ['-progname=' + applet] : [];
  let status = M.callMain([programs[applet] || applet, ...progname, ...(xdv ? ['-no-pdf'] : []), ...args]);
  if (status === 0 && xdv)
    status = M.callMain(['xdvipdfmx', '-q', '-o', xdv + '.pdf', xdv + '.xdv']);
  for (const [d] of dirs) copyOut(FS, d, copied);
  process.exit(status);
})();
