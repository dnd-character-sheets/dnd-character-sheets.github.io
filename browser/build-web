#!/usr/bin/env bash
# build-web -- assemble the form that typesets in the browser, and what it loads
#
# usage: build-web [-d DIR]
#
# Writes DIR/in-browser.html, the character form with its Generate PDF
# button typesetting in the browser, and DIR/in-browser/, the files it
# loads: BusyTeX, Lua with charsheet, the formats, the TeX Live files
# that sheets need (core.tar, with the templates), and the rest of their
# font families (extras.tar).  The worker loads each file NAME as
# NAME.gz, compressed by pigz -11 (zopfli), so that it downloads
# compressed from any server.  DIR defaults to browser/build/web.
# Run build-lua, build-texmf (with all three lists in browser/texlive),
# and build-formats (with BusyTeX, into browser/build/fmt-busytex) first.

set -euo pipefail
arg0=$(basename "$0")
root=$(cd "$(dirname "$0")/.." && pwd)
build=$root/browser/build
dir=$build/web

while getopts d: opt; do
  case $opt in
    d) dir=$OPTARG ;;
    *) echo "usage: $arg0 [-d DIR]" >&2; exit 2 ;;
  esac
done
assets=$dir/in-browser
rm -rf "$assets"
mkdir -p "$assets"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

cp "$root"/browser/web/* "$root/docs/charsheet.css" "$assets/"

# zipped FILE NAME: compress FILE into $assets/NAME.gz
zipped() { pigz -11 -c "$1" > "$assets/$2.gz"; }

for f in "$build"/engines/busytex/busytex.{js,wasm} "$build"/lua/lua.{js,wasm} "$build/lua/charsheet.lua"; do
  zipped "$f" "$(basename "$f")"
done

# stage DIR LIST...: copy the files in each LIST from the TeX tree into DIR/texmf
stage() {
  local d=$1
  shift
  sort -u "$@" | while read -r f; do install -D -m 644 "$build/texmf/$f" "$d/texmf/$f"; done
}

stage "$tmp/core" "$root/browser/texlive/sheets.files" \
      <(cd "$build/texmf" && find web2c fonts/map/pdftex fonts/conf -type f) \
      <(cd "$root/browser/texmf" && find . -type f | sed 's#^\./##')
mkdir -p "$tmp/core/charsheet/templates"
cp -L "$root"/templates/{charsheet,charsheet-packages,articlesize}.sty \
      "$root"/templates/{splash.png,splash-nocolor.png,merman.pdf} \
      "$root"/templates/{caster,silverpine,3col,tropical}.tex "$tmp/core/charsheet/templates/"
tar --format=ustar -C "$tmp/core" -cf "$tmp/core.tar" texmf charsheet
zipped "$tmp/core.tar" core.tar

stage "$tmp/extras" "$root/browser/texlive/extras.files"
tar --format=ustar -C "$tmp/extras" -cf "$tmp/extras.tar" texmf
zipped "$tmp/extras.tar" extras.tar

for engine in pdftex xetex; do
  zipped "$build/fmt-busytex/charsheet-$engine.fmt" "charsheet-$engine.fmt"
done

# the form, with sample sheets as in docs/index.html, typesetting in the browser
kings=(fighter barbarian cleric paladin rogue monk wizard sorcerer)
samples=("$root/yaml/mario.yaml")
for k in "${kings[@]}"; do samples+=("$root/yaml/king-$k.yaml"); done
for k in "${kings[@]}"; do
  "$root/lib/un3ify" "$root/yaml/king-$k.yaml" > "$tmp/silver-king-$k.yaml"
  samples+=("$tmp/silver-king-$k.yaml")
done
"$root/lib/insert-pregen-yamls" -html "$root/www/character-form.html" -o "$tmp/form.html" "${samples[@]}"
sed -e 's#href="charsheet.css"#href="in-browser/charsheet.css"#' \
    -e 's#\(Version: [a-z]*\)#\1, typesetting in your browser#' \
    -e 's#^</body>#<script src="in-browser/generate-pdf.js"></script>\n&#' \
    "$tmp/form.html" > "$dir/in-browser.html"
