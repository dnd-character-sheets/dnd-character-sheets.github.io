#!/usr/bin/env -S node --experimental-websocket
// browser-test -- typeset sheets in a headless browser and time it
//
// usage: browser-test chrome|firefox URL OUTDIR YAML...
//
// URL is selftest.html from build-web.  Runs the browser headless with a
// throwaway profile and typesets every YAML file three times: on a fresh
// page (pass `first`), again on the same page (`warm`), and after
// reloading the page, with the browser's cache full (`reload`).  Writes
// OUTDIR/NAME.pdf (or NAME.error) from the last pass and prints
// tab-separated lines PASS NAME MILLISECONDS on stdout.

'use strict';
const { spawn } = require('child_process');
const fs = require('fs');
const os = require('os');
const path = require('path');

const [browser, url, outdir, ...yamls] = process.argv.slice(2);
const cases = yamls.map(f => [path.basename(f, '.yaml'), fs.readFileSync(f, 'utf8')]);
const profile = fs.mkdtempSync(path.join(os.tmpdir(), 'browser-test-'));
fs.mkdirSync(outdir, { recursive: true });

// a JSON-RPC connection over a WebSocket: send(method, params, extra) -> result
function rpc(wsurl) {
  const ws = new WebSocket(wsurl);
  let id = 0;
  const pending = new Map();
  ws.onmessage = ({ data }) => {
    const m = JSON.parse(data);
    if (!pending.has(m.id)) return;
    const { resolve, reject } = pending.get(m.id);
    pending.delete(m.id);
    m.error ? reject(new Error(JSON.stringify(m.error))) : resolve(m.result);
  };
  const send = (method, params = {}, extra = {}) => new Promise((resolve, reject) => {
    pending.set(++id, { resolve, reject });
    ws.send(JSON.stringify({ id, method, params, ...extra }));
  });
  return new Promise((resolve, reject) => { ws.onopen = () => resolve(send); ws.onerror = reject; });
}

// the WebSocket URL a browser announces on stderr, matched by PATTERN
function announced(child, pattern) {
  return new Promise((resolve, reject) => {
    let text = '';
    child.stderr.on('data', d => { text += d; const m = text.match(pattern); if (m) resolve(m[1]); });
    child.on('exit', code => reject(new Error(`browser exited (${code}): ${text}`)));
  });
}

// kill CHILD; resolves when it has exited, so that its profile can go
function stopped(child) {
  return new Promise(resolve => { child.on('exit', resolve); child.kill(); });
}

// For each browser: start it, and return { open(url), evaluate(expr) -> string, reload(), close() }.
const browsers = {
  async chrome() {
    const child = spawn('google-chrome', ['--headless=new', `--user-data-dir=${profile}`, '--no-first-run',
      '--no-default-browser-check', '--remote-debugging-port=0', 'about:blank']);
    const send = await rpc(await announced(child, /DevTools listening on (ws:\S+)/));
    let session;
    const page = (method, params) => send(method, params, { sessionId: session });
    return {
      async open(u) {
        const { targetId } = await send('Target.createTarget', { url: u });
        ({ sessionId: session } = await send('Target.attachToTarget', { targetId, flatten: true }));
      },
      async evaluate(expression) {
        const r = await page('Runtime.evaluate', { expression, awaitPromise: true, returnByValue: true });
        if (r.exceptionDetails) throw new Error(JSON.stringify(r.exceptionDetails));
        return r.result.value;
      },
      reload: () => page('Page.reload', {}),
      close: () => stopped(child),
    };
  },
  async firefox() {
    const child = spawn('firefox', ['--headless', '--profile', profile, '--remote-debugging-port', '0', '--no-remote']);
    const send = await rpc((await announced(child, /WebDriver BiDi listening on (ws:\S+)/)) + '/session');
    await send('session.new', { capabilities: {} });
    const { contexts: [{ context }] } = await send('browsingContext.getTree', {});
    return {
      open: u => send('browsingContext.navigate', { context, url: u, wait: 'complete' }),
      async evaluate(expression) {
        const r = await send('script.evaluate', { expression, target: { context }, awaitPromise: true });
        if (r.type === 'exception') throw new Error(JSON.stringify(r.exceptionDetails));
        return r.result.value;
      },
      reload: () => send('browsingContext.reload', { context, wait: 'complete' }),
      close: () => stopped(child),
    };
  },
};

async function ready(b) {
  for (let i = 0; i < 600; i++) {
    try { if (await b.evaluate('typeof selftest') === 'function') return; } catch (e) { /* page not yet loaded */ }
    await new Promise(r => setTimeout(r, 100));
  }
  throw new Error('selftest.html never loaded');
}

(async () => {
  const b = await browsers[browser]();
  let status = 0;
  try {
    await b.open(url);
    await ready(b);
    let results;
    for (const pass of ['first', 'warm', 'reload']) {
      if (pass === 'reload') { await b.reload(); await ready(b); }
      results = JSON.parse(await b.evaluate(`selftest(${JSON.stringify(cases)}).then(JSON.stringify)`));
      for (const r of results) process.stdout.write(`${pass}\t${r.name}\t${Math.round(r.ms)}\n`);
    }
    for (const r of results) {
      if (r.pdf) fs.writeFileSync(path.join(outdir, r.name + '.pdf'), Buffer.from(r.pdf, 'base64'));
      else { fs.writeFileSync(path.join(outdir, r.name + '.error'), r.error); status = 1; }
    }
  } finally {
    await b.close();
    fs.rmSync(profile, { recursive: true, force: true });
  }
  process.exit(status);
})().catch(e => { console.error('browser-test:', e.message); process.exit(1); });
