#!/usr/bin/env bash
# build-texmf -- assemble the TeX tree that the browser engines read
#
# usage: build-texmf [-d DIR] LIST...
#
# Copies the TeX Live files named in each LIST (see texlive-files) into
# DIR (default browser/build/texmf), then adds browser/texmf, TeX Live's
# texmf.cnf, and a pdftex.map holding only the fonts whose TFMs are in
# DIR.

set -euo pipefail
arg0=$(basename "$0")
root=$(cd "$(dirname "$0")/.." && pwd)
dir=$root/browser/build/texmf

while getopts d: opt; do
  case $opt in
    d) dir=$OPTARG ;;
    *) echo "usage: $arg0 [-d DIR] LIST..." >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))

mapfile -t trees < <(grep -v '^#' "$root/browser/texlive-trees")
rm -rf "$dir"
mkdir -p "$dir"
failed=0
while read -r f; do
  found=
  for t in "${trees[@]}"; do
    [[ -f $t/$f ]] && { install -D -m 644 "$t/$f" "$dir/$f"; found=1; break; }
  done
  [[ -n $found ]] || { echo "$arg0: $f is not in TeX Live" >&2; failed=1; }
done < <(sort -u "$@")

cp -r "$root/browser/texmf/." "$dir/"
install -D -m 644 "$(kpsewhich -var-value=TEXMFDIST)/web2c/texmf.cnf" "$dir/web2c/texmf.cnf"

map=$dir/fonts/map/pdftex/pdftex.map
mkdir -p "$(dirname "$map")"
find "$dir/fonts/tfm" -name '*.tfm' -printf '%f\n' | sed 's/\.tfm$//' | sort -u > "$dir/tfm-names"
awk 'NR == FNR { tfm[$1] = 1; next } $1 in tfm' "$dir/tfm-names" "$(kpsewhich pdftex.map)" > "$map"
rm "$dir/tfm-names"

exit $failed
